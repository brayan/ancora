                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "promptVersion": {
                  "type": "string",
                  "const": "programming-hints-v1"
                },
                "schemaVersion": {
                  "type": "number",
                  "const": 1
                }
              },
              "required": [
                "provider",
                "name",
                "promptVersion",
                "schemaVersion"
              ],
              "additionalProperties": false
