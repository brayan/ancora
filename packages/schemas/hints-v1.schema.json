                "enum": [
                  "generating",
                  "ready",
                  "failed",
                  "interrupted"
                ]
              },
              "dispatches": {
                "type": "integer",
                "minimum": 1,
                "maximum": 2
              },
              "content": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1800,
                    "pattern": "\\S"
