{
  "schemaVersion": 1,
  "contracts": {
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "number",
          "const": 1
        },
        "level": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "challenge": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "objective": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            "statement": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000
            },
            "requirements": {
              "minItems": 1,
              "maxItems": 24,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              }
            },
            "functionContract": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "pattern": "^(?!__)[A-Za-z_][A-Za-z0-9_]{0,39}$"
                },
                "parameter": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "pattern": "^(?!__)[A-Za-z_][A-Za-z0-9_]{0,39}$"
                    },
                    "type": {
                      "type": "string",
                      "enum": [
                        "int",
                        "str",
                        "list[int]",
                        "list[str]",
                        "dict[str,int]",
                        "dict[str,str]"
                      ]
                    }
                  },
                  "required": [
                    "name",
                    "type"
                  ],
                  "additionalProperties": false
                },
                "returns": {
                  "type": "string",
                  "enum": [
                    "int",
                    "str",
                    "list[int]",
                    "list[str]",
                    "dict[str,int]",
                    "dict[str,str]"
                  ]
                }
              },
              "required": [
                "name",
                "parameter",
                "returns"
              ],
              "additionalProperties": false
            },
            "technique": {
              "type": "string",
              "enum": [
                "none",
                "list_comprehension",
                "dict_comprehension"
              ]
            },
            "publicCases": {
              "minItems": 1,
              "maxItems": 12,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9@_.:-]{1,100}$"
                  },
                  "input": {
                    "anyOf": [
                      {
                        "anyOf": [
                          {
                            "type": "integer",
                            "minimum": -1000000,
                            "maximum": 1000000
                          },
                          {
                            "type": "string",
                            "maxLength": 2000
                          }
                        ]
                      },
                      {
                        "maxItems": 1000,
                        "type": "array",
                        "items": {
                          "type": "integer",
                          "minimum": -1000000,
                          "maximum": 1000000
                        }
                      },
                      {
                        "maxItems": 100,
                        "type": "array",
                        "items": {
                          "type": "string",
                          "maxLength": 2000
                        }
                      },
                      {
                        "type": "object",
                        "propertyNames": {
                          "type": "string",
                          "maxLength": 100
                        },
                        "additionalProperties": {
                          "type": "integer",
                          "minimum": -1000000,
                          "maximum": 1000000
                        }
                      },
                      {
                        "type": "object",
                        "propertyNames": {
                          "type": "string",
                          "maxLength": 100
                        },
                        "additionalProperties": {
                          "type": "string",
                          "maxLength": 2000
                        }
                      }
                    ]
                  },
                  "expected": {
                    "anyOf": [
                      {
                        "anyOf": [
                          {
                            "type": "integer",
                            "minimum": -1000000,
                            "maximum": 1000000
                          },
                          {
                            "type": "string",
                            "maxLength": 2000
                          }
                        ]
                      },
                      {
                        "maxItems": 1000,
                        "type": "array",
                        "items": {
                          "type": "integer",
                          "minimum": -1000000,
                          "maximum": 1000000
                        }
                      },
                      {
                        "maxItems": 100,
                        "type": "array",
                        "items": {
                          "type": "string",
                          "maxLength": 2000
                        }
                      },
                      {
                        "type": "object",
                        "propertyNames": {
                          "type": "string",
                          "maxLength": 100
                        },
                        "additionalProperties": {
                          "type": "integer",
                          "minimum": -1000000,
                          "maximum": 1000000
                        }
                      },
                      {
                        "type": "object",
                        "propertyNames": {
                          "type": "string",
                          "maxLength": 100
                        },
                        "additionalProperties": {
                          "type": "string",
                          "maxLength": 2000
                        }
                      }
                    ]
                  }
                },
                "required": [
                  "id",
                  "input",
                  "expected"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "title",
            "objective",
            "statement",
            "requirements",
            "functionContract",
            "technique",
            "publicCases"
          ],
          "additionalProperties": false
        },
        "previousHints": {
          "maxItems": 2,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1800,
            "pattern": "\\S"
          }
        }
      },
      "required": [
        "schemaVersion",
        "level",
        "challenge",
        "previousHints"
      ],
      "additionalProperties": false
