{
  "schemaVersion": 1,
  "contracts": {
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "number",
          "const": 1
        },
        "challenge": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "objective": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            "statement": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000
            },
            "requirements": {
              "minItems": 1,
              "maxItems": 24,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              }
            },
            "functionContract": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "pattern": "^(?!__)[A-Za-z_][A-Za-z0-9_]{0,39}$"
                },
                "parameter": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "pattern": "^(?!__)[A-Za-z_][A-Za-z0-9_]{0,39}$"
                    },
                    "type": {
                      "type": "string",
                      "enum": [
                        "int",
                        "str",
                        "list[int]",
                        "list[str]",
                        "dict[str,int]",
                        "dict[str,str]"
                      ]
                    }
                  },
                  "required": [
                    "name",
                    "type"
                  ],
                  "additionalProperties": false
                },
                "returns": {
                  "type": "string",
                  "enum": [
                    "int",
                    "str",
                    "list[int]",
                    "list[str]",
                    "dict[str,int]",
                    "dict[str,str]"
                  ]
                }
              },
              "required": [
                "name",
                "parameter",
                "returns"
              ],
              "additionalProperties": false
            },
            "technique": {
              "type": "string",
              "enum": [
                "none",
                "list_comprehension",
                "dict_comprehension"
              ]
            },
            "publicCases": {
              "minItems": 1,
              "maxItems": 12,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9@_.:-]{1,100}$"
                  },
                  "input": {
                    "anyOf": [
                      {
                        "anyOf": [
                          {
                            "type": "integer",
                            "minimum": -1000000,
                            "maximum": 1000000
                          },
                          {
                            "type": "string",
                            "maxLength": 2000
                          }
                        ]
                      },
                      {
                        "maxItems": 1000,
                        "type": "array",
                        "items": {
                          "type": "integer",
                          "minimum": -1000000,
                          "maximum": 1000000
                        }
                      },
                      {
                        "maxItems": 100,
                        "type": "array",
                        "items": {
                          "type": "string",
                          "maxLength": 2000
                        }
                      },
                      {
                        "type": "object",
                        "propertyNames": {
                          "type": "string",
                          "maxLength": 100
                        },
                        "additionalProperties": {
                          "type": "integer",
                          "minimum": -1000000,
                          "maximum": 1000000
                        }
                      },
                      {
                        "type": "object",
                        "propertyNames": {
                          "type": "string",
                          "maxLength": 100
                        },
                        "additionalProperties": {
                          "type": "string",
                          "maxLength": 2000
                        }
                      }
                    ]
                  },
                  "expected": {
                    "anyOf": [
                      {
                        "anyOf": [
                          {
                            "type": "integer",
                            "minimum": -1000000,
                            "maximum": 1000000
                          },
                          {
                            "type": "string",
                            "maxLength": 2000
                          }
                        ]
                      },
                      {
                        "maxItems": 1000,
                        "type": "array",
                        "items": {
                          "type": "integer",
                          "minimum": -1000000,
                          "maximum": 1000000
                        }
                      },
                      {
                        "maxItems": 100,
                        "type": "array",
                        "items": {
                          "type": "string",
                          "maxLength": 2000
                        }
                      },
                      {
                        "type": "object",
                        "propertyNames": {
                          "type": "string",
                          "maxLength": 100
                        },
                        "additionalProperties": {
                          "type": "integer",
                          "minimum": -1000000,
                          "maximum": 1000000
                        }
                      },
                      {
                        "type": "object",
                        "propertyNames": {
                          "type": "string",
                          "maxLength": 100
                        },
                        "additionalProperties": {
                          "type": "string",
                          "maxLength": 2000
                        }
                      }
                    ]
                  }
                },
                "required": [
                  "id",
                  "input",
                  "expected"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "title",
            "objective",
            "statement",
            "requirements",
            "functionContract",
            "technique",
            "publicCases"
          ],
          "additionalProperties": false
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12000,
          "pattern": "\\S"
        },
        "evidence": {
          "type": "object",
          "properties": {
            "execution": {
              "type": "string",
              "enum": [
                "result",
                "execution_error",
                "timeout",
                "stopped",
                "output_limit",
                "bootstrap_error",
                "invalid_message"
              ]
            },
            "passed": {
              "type": "integer",
              "minimum": 0,
              "maximum": 12
            },
            "total": {
              "type": "integer",
              "minimum": 0,
              "maximum": 12
            },
            "technique": {
              "type": "string",
              "enum": [
                "passed",
                "failed",
                "inconclusive",
                "not_required"
              ]
            }
          },
          "required": [
            "execution",
            "passed",
            "total",
            "technique"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schemaVersion",
        "challenge",
        "source",
        "evidence"
      ],
      "additionalProperties": false
    },
    "draft": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 900,
          "pattern": "\\S"
        },
        "observations": {
          "minItems": 1,
          "maxItems": 4,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 900,
            "pattern": "\\S"
          }
        },
        "nextStep": {
          "type": "string",
          "minLength": 1,
          "maxLength": 900,
          "pattern": "\\S"
        }
      },
      "required": [
        "summary",
        "observations",
        "nextStep"
      ],
      "additionalProperties": false
    },
    "output": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "number",
          "const": 1
        },
        "feedback": {
          "type": "object",
          "properties": {
            "summary": {
              "type": "string",
              "minLength": 1,
              "maxLength": 900,
              "pattern": "\\S"
            },
            "observations": {
              "minItems": 1,
              "maxItems": 4,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 900,
                "pattern": "\\S"
              }
            },
            "nextStep": {
              "type": "string",
              "minLength": 1,
              "maxLength": 900,
              "pattern": "\\S"
            }
          },
          "required": [
            "summary",
            "observations",
            "nextStep"
          ],
          "additionalProperties": false
        },
        "model": {
          "type": "object",
          "properties": {
            "provider": {
              "type": "string",
              "const": "openai"
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "promptVersion": {
              "type": "string",
              "const": "programming-coaching-v1"
            },
            "schemaVersion": {
              "type": "number",
              "const": 1
            }
          },
          "required": [
            "provider",
            "name",
            "promptVersion",
            "schemaVersion"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schemaVersion",
        "feedback",
        "model"
      ],
      "additionalProperties": false
    },
    "view": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "attemptId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "revisionId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9@_.:-]{1,100}$"
        },
        "sourceDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "consentVersion": {
          "type": "string",
          "const": "code-sharing-v1"
        },
        "sharedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
        },
        "state": {
          "type": "string",
          "enum": [
            "generating",
            "ready",
            "failed",
            "interrupted"
          ]
        },
        "dispatches": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2
        },
        "feedback": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "summary": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 900,
                  "pattern": "\\S"
                },
                "observations": {
                  "minItems": 1,
                  "maxItems": 4,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 900,
                    "pattern": "\\S"
                  }
                },
                "nextStep": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 900,
                  "pattern": "\\S"
                }
              },
              "required": [
                "summary",
                "observations",
                "nextStep"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "model": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "provider": {
                  "type": "string",
                  "const": "openai"
                },
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "promptVersion": {
                  "type": "string",
                  "const": "programming-coaching-v1"
                },
                "schemaVersion": {
                  "type": "number",
                  "const": 1
                }
              },
              "required": [
                "provider",
                "name",
                "promptVersion",
                "schemaVersion"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "error": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "coaching_invalid",
                "provider_interrupted",
                "coaching_unavailable"
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "attemptId",
        "revisionId",
        "sourceDigest",
        "consentVersion",
        "sharedAt",
        "state",
        "dispatches",
        "feedback",
        "model",
        "error"
      ],
      "additionalProperties": false
    },
    "status": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "apiVersion": {
          "type": "number",
          "const": 1
        },
        "available": {
          "type": "boolean"
        },
        "model": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            {
              "type": "null"
            }
          ]
        },
        "coaching": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "format": "uuid",
                  "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                },
                "attemptId": {
                  "type": "string",
                  "format": "uuid",
                  "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                },
                "revisionId": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9@_.:-]{1,100}$"
                },
                "sourceDigest": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "consentVersion": {
                  "type": "string",
                  "const": "code-sharing-v1"
                },
                "sharedAt": {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
                },
                "state": {
                  "type": "string",
                  "enum": [
                    "generating",
                    "ready",
                    "failed",
                    "interrupted"
                  ]
                },
                "dispatches": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 2
                },
                "feedback": {
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "summary": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 900,
                          "pattern": "\\S"
                        },
                        "observations": {
                          "minItems": 1,
                          "maxItems": 4,
                          "type": "array",
                          "items": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 900,
                            "pattern": "\\S"
                          }
                        },
                        "nextStep": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 900,
                          "pattern": "\\S"
                        }
                      },
                      "required": [
                        "summary",
                        "observations",
                        "nextStep"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "model": {
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "provider": {
                          "type": "string",
                          "const": "openai"
                        },
                        "name": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 100
                        },
                        "promptVersion": {
                          "type": "string",
                          "const": "programming-coaching-v1"
                        },
                        "schemaVersion": {
                          "type": "number",
                          "const": 1
                        }
                      },
                      "required": [
                        "provider",
                        "name",
                        "promptVersion",
                        "schemaVersion"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "error": {
                  "anyOf": [
                    {
                      "type": "string",
                      "enum": [
                        "coaching_invalid",
                        "provider_interrupted",
                        "coaching_unavailable"
                      ]
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "id",
                "attemptId",
                "revisionId",
                "sourceDigest",
                "consentVersion",
                "sharedAt",
                "state",
                "dispatches",
                "feedback",
                "model",
                "error"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "apiVersion",
        "available",
        "model",
        "coaching"
      ],
      "additionalProperties": false
    },
    "request": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "apiVersion": {
          "type": "number",
          "const": 1
        },
        "id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "attemptId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "shareCode": {
          "type": "boolean",
          "const": true
        }
      },
      "required": [
        "apiVersion",
        "id",
        "attemptId",
        "shareCode"
      ],
      "additionalProperties": false
    },
    "retry": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "apiVersion": {
          "type": "number",
          "const": 1
        },
        "shareCode": {
          "type": "boolean",
          "const": true
        }
      },
      "required": [
        "apiVersion",
        "shareCode"
      ],
      "additionalProperties": false
    }
  }
